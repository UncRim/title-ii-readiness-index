# Optional: default project page for the crawler's User-Agent, used when the run page's
# Project page address field is left blank. It must explain the scan and how to opt out, be
# public (not localhost), and not be a .gov host unless allowed below.
# READINESS_CONTACT_URL=https://yourdomain.org/your-study-page

# Comma-separated hostnames (no https://) allowed to use a .gov contact URL when you truly
# control that page (e.g. your agency's opt-out page).
# READINESS_ALLOWED_GOV_CONTACT_HOSTS=project.example.gov
# NEXT_PUBLIC_READINESS_ALLOWED_GOV_CONTACT_HOSTS=project.example.gov
